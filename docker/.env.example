# Puertos publicados en el host (ajustelos si ya estan ocupados)
APP_PORT=8080
FRONTEND_PORT=5173
DB_PORT_HOST=5433

# Entorno del backend
APP_ENV=local
APP_DEBUG=true

# PostgreSQL
DB_DATABASE=examenes_medicos
