DB_PASSWORD=secret

# Usuario administrador creado por el seeder
ADMIN_EMAIL=admin@centromedico.test
ADMIN_PASSWORD=password

# Nombre mostrado en la SPA
MEDICAL_CENTER_NAME=Centro Medico Ocupacional
